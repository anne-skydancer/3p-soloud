<?xml version="1.0" ?>
<llsd>
<map>
    <key>version</key><string>1.3</string>
    <key>type</key><string>autobuild</string>
    <key>package_description</key>
    <map>
        <key>canonical_repo</key><string>https://github.com/anne-skydancer/3p-soloud</string>
        <key>name</key><string>soloud</string>
        <key>description</key><string>SoLoud with bounded multichannel miniaudio callbacks</string>
        <key>license</key><string>Zlib</string>
        <key>license_file</key><string>LICENSES/soloud.txt</string>
        <key>copyright</key><string>Copyright (c) 2013-2020 Jari Komppa</string>
        <key>version_file</key><string>VERSION.txt</string>
        <key>platforms</key>
        <map>
            <key>windows64</key>
            <map>
                <key>name</key><string>windows64</string>
                <key>build_directory</key><string>stage</string>
                <key>manifest</key>
                <array>
                    <string>lib/release/soloud.lib</string>
                    <string>include/soloud/*.h</string>
                    <string>LICENSES/*.txt</string>
                    <string>VERSION.txt</string>
                </array>
                <key>configurations</key>
                <map>
                    <key>release</key>
                    <map>
                        <key>name</key><string>release</string>
                        <key>default</key><string>True</string>
                        <key>build</key>
                        <map>
                            <key>command</key><string>cmake</string>
                            <key>options</key>
                            <array><string>-P</string><string>../build.cmake</string></array>
                        </map>
                    </map>
                </map>
            </map>
        </map>
    </map>
</map>
</llsd>